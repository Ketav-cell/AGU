# GridSpark AI .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.env

# Jupyter checkpoints
.ipynb_checkpoints/
*.ipynb.bak

# Large raw data files (download manually per README)
data/raw/*.zip
data/raw/*.gdb/
data/raw/*.gpkg
data/raw/*.shp
data/raw/*.dbf
data/raw/*.shx
data/raw/*.prj
data/raw/*.cpg
data/raw/*.csv

# Processed GeoJSON files (regenerated by scripts)
data/processed/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Keep directory structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/.gitkeep
!outputs/figures/.gitkeep
